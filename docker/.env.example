# Variables for compose.qlane.yml. Set each on the Qlane test target; the stack refuses to start
# while any of them is empty. Generate each secret with `openssl rand -hex 32`.

# PostgreSQL superuser password. Hex or alphanumeric only: it is placed in database URLs unescaped.
POSTGRES_PASSWORD=
# Password of the SpiceDB datastore role.
AUTHZED_DATABASE_PASSWORD=
# SpiceDB's preshared key, shared by the app and SpiceDB.
AUTHZED_TOKEN=
# Signs session cookies and invite, verification and email-change tokens.
BETTER_AUTH_SECRET=
# 2FA and single-use link survey URLs.
ENCRYPTION_KEY=
# Authenticates cron job calls.
CRON_SECRET=
# Formbricks Hub API key, shared by the app and Hub.
HUB_API_KEY=
# Cube API secret, shared by the app and Cube.
CUBEJS_API_SECRET=
# Password of the QA login (qa@example.com), 8 to 128 characters with an uppercase letter and a digit.
QA_PASSWORD=
